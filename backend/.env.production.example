# Production profile (placeholder values only)
DJANGO_ENV=production
DEBUG=false

# Required: use a long random value from your secret manager.
SECRET_KEY=<set-64-plus-char-random-secret>

# Domain allow-list for Django host validation.
ALLOWED_HOSTS=<api.example.com>

# Full origins with scheme for CSRF checks.
CSRF_TRUSTED_ORIGINS=<https://app.example.com,https://api.example.com>

# Secure cookies and HTTPS behavior.
SESSION_COOKIE_SECURE=true
CSRF_COOKIE_SECURE=true
SESSION_COOKIE_SAMESITE=Lax
CSRF_COOKIE_SAMESITE=Lax
SECURE_SSL_REDIRECT=true
USE_X_FORWARDED_PROTO=true
SECURE_REFERRER_POLICY=strict-origin-when-cross-origin
X_FRAME_OPTIONS=DENY
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=true
SECURE_HSTS_PRELOAD=false

# PostgreSQL connection placeholders.
DB_NAME=<postgres-db-name>
DB_USER=<postgres-db-user>
DB_PASSWORD=<postgres-db-password>
DB_HOST=<postgres-db-host>
DB_PORT=5432

# Deterministic progression threshold.
PROGRESSION_STABLE_THRESHOLD=0.05
