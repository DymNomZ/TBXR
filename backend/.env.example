DJANGO_ENV=development
DEBUG=true

# Required in production when DEBUG=false.
SECRET_KEY=replace-with-long-random-secret

# Comma-separated hostnames/domain names.
ALLOWED_HOSTS=localhost,127.0.0.1,testserver

# Comma-separated origin URLs (including scheme) for CSRF validation.
CSRF_TRUSTED_ORIGINS=http://localhost:5173

# Cookie/security flags. Set these to true in production behind HTTPS.
SESSION_COOKIE_SECURE=false
CSRF_COOKIE_SECURE=false
SECURE_SSL_REDIRECT=false
USE_X_FORWARDED_PROTO=false

# Leave DB_NAME empty to use SQLite locally.
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
# Absolute change in AI TB probability required to leave "stable".
# Must be between 0 and 1. Defaults to 0.05 when unset.
# See documentation/progression-service.md
PROGRESSION_STABLE_THRESHOLD=0.05
